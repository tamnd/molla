# Build output
/build/
/target/
/dist/
*.mojopkg
*.o
*.a

# Pixi. The lock file is committed on purpose, that is the whole point of
# pinning the toolchain.
/.pixi/
spikes/*/.pixi/
pixi.lock.bak

# Spike binaries. These have no extension, so they need naming one by one.
/spikes/qmatmul/qmatmul_cpu
/spikes/qmatmul/qmatmul_gpu
/spikes/qmatmul/qmatmul_nv
/spikes/qmatmul/appleprobe
/spikes/qmatmul/shape.txt
/spikes/qmatmul/shape_q40.txt

# The conformance corpora. A gigabyte of real `tokenizer.json` files and a few
# megabytes of real chat templates, which `scripts/fetch-tokenizers.py` and
# `scripts/fetch-templates.py` download and check the digests of.
/corpus/

# Local state. Never commit a model store.
/.molla/
*.gguf
*.safetensors
*.bin

# The oracle scripts are Python, and importing one leaves this behind.
__pycache__/

# Editors and OS
.DS_Store
.vscode/
.idea/
*.swp

# Test and bench output
/target/test-results/
*.sarif
bench.json
