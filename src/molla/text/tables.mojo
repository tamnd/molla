"""Unicode tables, generated by scripts/gen-unicode.py.

Do not edit this by hand. Regenerate it, and say in the commit which Unicode
version the Python that generated it was carrying. This one is 16.0.0.

The encoding is a base 64 varint, five payload bits per digit, low bits first,
0x20 set on every digit but the last of a number. The reader is in props.mojo
and it is fifteen lines. Range tables hold a delta from the end of the range
before, then the length minus one, then the value. Mapping tables hold a delta
from the code point before, then a header, then the code points.

Hangul syllables are not in the decomposition table. They decompose by formula
and props.mojo does it that way.
"""

comptime UNICODE_VERSION = "16.0.0"

"""The Unicode version of the database these came out of."""

comptime CATEGORY_COUNT = 3368
"""Ranges in the general category table. Unassigned is not in it."""

comptime CATEGORY_DATA = ""
"""Start, length and category index per range, as varints."""

comptime COMBINING_COUNT = 393
"""Ranges in the combining class table. Class zero is not in it."""

comptime COMBINING_DATA = ""
"""Start, length and combining class per range, as varints."""

comptime DECOMPOSITION_COUNT = 5913
"""Characters with a decomposition, Hangul excluded."""

comptime DECOMPOSITION_DATA = ""
"""Code point delta, then length shifted left two with the compatibility bit at 1 and the composition exclusion bit at 2, then the code points."""

comptime LOWERCASE_COUNT = 1460
"""Characters that lowercase to something else."""

comptime LOWERCASE_DATA = ""
"""Code point delta, then length, then the code points."""

comptime GRAPHEME_COUNT = 1481
"""Ranges in the grapheme break table. Plain text is not in it."""

comptime GRAPHEME_DATA = ""
"""Start, length and packed break property per range, as varints. Four bits of break class, then the pictographic bit, then two bits of Indic conjunct class."""
